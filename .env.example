# Боевой домен без слэша в конце. Используется для canonical, OG и sitemap.
# На Vercel добавьте её в Project Settings → Environment Variables.
NEXT_PUBLIC_SITE_URL=

# Telegram-бот для заявок с сайта (POST /api/lead).
# 1. Создайте бота у @BotFather и вставьте токен.
# 2. Добавьте бота в чат/группу, напишите туда сообщение и узнайте chat_id
#    через https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
